# Copy to backend/.env and fill in. NEVER commit .env - it is gitignored.
#
# Every value below is already the local-friendly default, so a fresh clone runs
# with no .env at all: mock VOW data, in-memory state, no LLM, no secrets.
# Uncomment only what you need to change.

# --- Service ---------------------------------------------------------------
ENVIRONMENT=local
DEBUG=true

# --- Logging ---------------------------------------------------------------
# DEBUG includes full MCP payloads and the raw brief - client-commercial data.
# Keep production at INFO.
LOG_LEVEL=INFO
# Console format only; the file is always JSON, ready for Datadog.
LOG_FORMAT=text
LOG_FILE=logs/vow-agent.log
# Budget for EVERYTHING in logs/ combined, not per file.
LOG_TOTAL_MAX_BYTES=10000000

# --- LLM -------------------------------------------------------------------
# Leave empty and the agent falls back to pattern matching. That is why tests
# and CI need no secret. With a key it understands messier briefs
# ("about fifty grand this summer").
OPENAI_API_KEY=
LLM_MODEL=gpt-4o-mini

# --- VOW access via MCP ----------------------------------------------------
# true = canned VOW responses, no server contacted. The real MCP server does
# not exist yet (TMP-04), so this is the only working setting today.
USE_MOCK_MCP=true
MCP_SERVER_URL=
# Empty until the client confirms how the agent authenticates (open question A1).
MCP_AUTH_TOKEN=

# --- Governance ------------------------------------------------------------
# Empty uses the policy shipped in app/governance/policies/vow_ctv.yaml.
# There is deliberately no on/off switch: a guardrail an env var can disable
# is not a guardrail.
GOVERNANCE_POLICY_PATH=

# EMERGENCY STOP. The PRESENCE of this file halts every VOW call:
#   touch KILL_SWITCH   -> agent halted
#   rm KILL_SWITCH      -> agent resumes
# Takes effect on the next call. No restart, no deploy.
KILL_SWITCH_PATH=KILL_SWITCH

# --- Audit trail -----------------------------------------------------------
# The durable record of every allow/deny decision. Separate from logging: logs
# expire, this is evidence. Leave both empty and records are held in memory and
# lost on restart - fine for tests, not for compliance. The service warns
# loudly at startup when unconfigured.
#
# TMP-01: a local file is a stopgap; a file inside a container dies on every
# deploy. Moving to Postgres once we have database access.
AUDIT_LOG_PATH=
# Signs each entry so tampering is detectable. A REAL SECRET - never commit it,
# and note that rotating it makes older entries unverifiable.
AUDIT_HMAC_KEY=

# --- Multi-tenancy ---------------------------------------------------------
# Used only when ENVIRONMENT=local and the UI is not yet sending the
# Vowmade-Advertiser-Id header. Staging and production reject instead.
DEV_ADVERTISER_ID=dev-advertiser-0001

# --- Database --------------------------------------------------------------
# docker compose provides this locally.
DATABASE_URL=postgresql+asyncpg://vowagent:vowagent@localhost:5432/vowagent
# true = in-memory (no Postgres needed; conversations lost on restart)
USE_MEMORY_CHECKPOINTER=true

# --- CORS ------------------------------------------------------------------
# MUST be JSON - a bare URL fails to parse and the service will not start.
# The frontend dev server runs on 3000 (see frontend/vite.config.ts), and the
# Module Federation remote on 3001.
CORS_ORIGINS=["http://localhost:3000","http://localhost:3001"]

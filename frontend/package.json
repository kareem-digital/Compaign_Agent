{
  "name": "vow-agent-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:local": "vite --port 3001 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "dev:remote": "vite --mode remote",
    "build:remote": "tsc -b && vite build --mode remote",
    "build:all": "tsc -b && vite build && vite build --mode remote",
    "preview:remote": "vite preview --mode remote",
    "mock:dev": "npm --prefix mock-server run dev",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "posttest:coverage": "node scripts/copy-coverage-report.mjs && node scripts/generate-lint-report.mjs",
    "report:open": "vite preview --outDir reports --open /agent/frontend-Vitest_report.html",
    "docker:build": "docker build -t vow-agent-frontend .",
    "docker:run": "docker run -d -p 8080:80 --name vow-agent-frontend vow-agent-frontend"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "oidc-client-ts": "^3.5.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@module-federation/vite": "^1.19.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^3.2.7",
    "@vitest/ui": "^3.2.7",
    "daisyui": "^5.7.8",
    "eslint": "^9.17.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.16",
    "globals": "^15.14.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1",
    "vite": "^6.0.5",
    "vitest": "^3.0.0"
  }
}

{
  "id": "budget-followup",
  "description": "Reached only via `next` from elc_budget, hence match.type \"none\". {{answer}} is the server-rendered answer, which proves ids resolved to values server-side.",
  "match": { "type": "none" },
  "delayMs": 400,
  "response": {
    "status": 200,
    "body": {
      "stage": "audiences",
      "content": [
        {
          "type": "text",
          "text": "Got it — {{answer}}. I'll plan against that.\n\nOne more thing."
        },
        {
          "type": "options",
          "id": "elc_audience",
          "prompt": "Which audiences should I prioritise?",
          "context_label": "Audiences",
          "select": "multi",
          "allow_custom": false,
          "options": [
            { "id": "opt_abc1", "label": "25–44 ABC1", "value": "25–44 ABC1" },
            {
              "id": "opt_retarget",
              "label": "First-party retargeting",
              "value": "first-party retargeting pool"
            },
            {
              "id": "opt_sport",
              "label": "Live sport viewers",
              "value": "live sport viewers"
            }
          ],
          "next": "audience-followup"
        }
      ]
    }
  }
}
